<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_dashboard</name>
  <version>0.1.0</version>
  <description>Web digital twin dashboard for the BabyROS arm_6dof (Three.js + rosbridge)</description>
  <maintainer email="dev@example.com">BabyROS</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rosbridge_server</depend>

  <exec_depend>web_video_server</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
