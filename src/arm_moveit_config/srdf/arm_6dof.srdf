<robot name="arm_6dof">
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="base_link" />
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0" />
  </group>
  <group name="gripper">
    <joint name="left_finger_joint" />
    <joint name="right_finger_joint" />
  </group>
  <group name="arm_gripper">
    <chain base_link="base_link" tip_link="left_finger" />
  </group>
  <end_effector name="gripper_eef" parent_link="gripper_palm" group="gripper" parent_group="arm" />
  <group_state name="home" group="arm">
    <joint name="joint_1" value="0" />
    <joint name="joint_2" value="0" />
    <joint name="joint_3" value="0" />
    <joint name="joint_4" value="0" />
    <joint name="joint_5" value="1.5708" />
    <joint name="joint_6" value="0" />
  </group_state>
  <group_state name="pre_pick" group="arm">
    <joint name="joint_1" value="0" />
    <joint name="joint_2" value="1.2" />
    <joint name="joint_3" value="-1.6" />
    <joint name="joint_4" value="0" />
    <joint name="joint_5" value="0" />
    <joint name="joint_6" value="0" />
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0" />
    <joint name="right_finger_joint" value="0" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.03" />
    <joint name="right_finger_joint" value="0.03" />
  </group_state>
  <disable_collisions link1="world" link2="base_link" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="world" link2="camera_table_link" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="world" link2="camera_stick_link" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="link_5" link2="gripper_palm" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="gripper_palm" link2="left_finger" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="gripper_palm" link2="right_finger" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="gripper_palm" link2="tool0" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="gripper_palm" link2="camera_ee_link" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="left_finger" link2="right_finger" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="left_finger" link2="link_2" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="right_finger" link2="link_2" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="left_finger" link2="link_3" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="right_finger" link2="link_3" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="left_finger" link2="link_4" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="right_finger" link2="link_4" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="left_finger" link2="link_5" reason="Adjacent or mimic-coupled" />
  <disable_collisions link1="right_finger" link2="link_5" reason="Adjacent or mimic-coupled" />
</robot>