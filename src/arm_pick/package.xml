<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_pick</name>
  <version>0.1.0</version>
  <description>Autonomous pick-and-place for the BabyROS arm_6dof with switchable ground-truth/vision localization</description>
  <maintainer email="dev@example.com">BabyROS</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>moveit_commander</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
