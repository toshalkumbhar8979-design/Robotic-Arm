<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bringup</name>
  <version>0.1.0</version>
  <description>Full-stack launch for the BabyROS arm_6dof: sim, MoveIt, teleop, pick, web dashboard</description>
  <maintainer email="dev@example.com">BabyROS</maintainer>
  <license>MIT</license>

  <exec_depend>arm_description</exec_depend>
  <exec_depend>arm_moveit_config</exec_depend>
  <exec_depend>arm_teleop</exec_depend>
  <exec_depend>arm_pick</exec_depend>
  <exec_depend>web_dashboard</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
